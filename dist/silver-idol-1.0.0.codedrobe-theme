      "css": "html.codedrobe-host-workbuddy {\n  --wbts-bg: #eef0f7;\n  --wbts-panel: rgba(250, 250, 255, 0.9);\n  --wbts-panel-strong: #f5f4fb;\n  --wbts-border: rgba(100, 96, 140, 0.2);\n  --wbts-text: #28283a;\n  --wbts-muted: #79788f;\n  --wbts-accent: #8b7be8;\n  --wbts-accent-two: #6e7ea8;\n  --wbts-accent-soft: rgba(139, 123, 232, 0.13);\n  color-scheme: light;\n}\n\nhtml.codedrobe-host-workbuddy body,\nhtml.codedrobe-host-workbuddy .teams-container {\n  background: var(--wbts-bg) !important;\n  color: var(--wbts-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy :is(.teams-main-content, .main-content, .chat-container) {\n  background-color: var(--wbts-bg) !important;\n  background-image:\n    radial-gradient(circle at 82% 18%, rgba(204, 196, 255, 0.55), transparent 32%),\n    radial-gradient(circle at 36% 80%, rgba(198, 219, 255, 0.58), transparent 38%),\n    linear-gradient(145deg, #f8f9fc, #e8eaf3) !important;\n  color: var(--wbts-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy :is(.conversation-sidebar, .conversation-list, .workbuddy-topbar, .wb-home-page) {\n  background: var(--wbts-panel) !important;\n  border-color: var(--wbts-border) !important;\n  color: var(--wbts-text) !important;\n  backdrop-filter: blur(18px) saturate(115%);\n}\n\nhtml.codedrobe-host-workbuddy :is(.conversation-list, .workbuddy-topbar, .wb-home-page) :where(*) {\n  border-color: var(--wbts-border) !important;\n  color: inherit !important;\n}\n\nhtml.codedrobe-host-workbuddy :is(.conversation-list-header, .conversation-list-content, .conversation-list-footer) :where(*) {\n  color: var(--wbts-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .conversation-list .conversation-agent-card span {\n  color: var(--wbts-text) !important;\n  -webkit-text-fill-color: var(--wbts-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .conversation-section-label :where(*) {\n  color: var(--wbts-muted) !important;\n}\n\nhtml.codedrobe-host-workbuddy :is(.wb-home-page, .wb-home-compos