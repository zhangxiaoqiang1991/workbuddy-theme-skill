      "css": "html.codedrobe-host-workbuddy {\n  --wbts-bg: #100b2b;\n  --wbts-panel: rgba(30, 20, 68, 0.91);\n  --wbts-panel-strong: #291b5b;\n  --wbts-border: rgba(251, 211, 109, 0.28);\n  --wbts-text: #fbf7ff;\n  --wbts-muted: #bdb0d9;\n  --wbts-accent: #c084fc;\n  --wbts-accent-two: #fbd36d;\n  --wbts-accent-soft: rgba(192, 132, 252, 0.17);\n  color-scheme: dark;\n}\n\nhtml.codedrobe-host-workbuddy body,\nhtml.codedrobe-host-workbuddy .teams-container {\n  background: var(--wbts-bg) !important;\n  color: var(--wbts-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy :is(.teams-main-content, .main-content, .chat-container) {\n  background-color: var(--wbts-bg) !important;\n  background-image:\n    radial-gradient(circle at 15% 18%, rgba(251, 211, 109, 0.12) 0 2px, transparent 3px),\n    radial-gradient(circle at 83% 22%, rgba(192, 132, 252, 0.29), transparent 32%),\n    radial-gradient(circle at 40% 82%, rgba(94, 234, 212, 0.1), transparent 34%),\n    linear-gradient(145deg, #100b2b, #211248) !important;\n  color: var(--wbts-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy :is(.conversation-sidebar, .conversation-list, .workbuddy-topbar, .wb-home-page) {\n  background: var(--wbts-panel) !important;\n  border-color: var(--wbts-border) !important;\n  color: var(--wbts-text) !important;\n  backdrop-filter: blur(20px) saturate(130%);\n}\n\nhtml.codedrobe-host-workbuddy :is(.conversation-list, .workbuddy-topbar, .wb-home-page) :where(*) {\n  border-color: var(--wbts-border) !important;\n  color: inherit !important;\n}\n\nhtml.codedrobe-host-workbuddy :is(.conversation-list-header, .conversation-list-content, .conversation-list-footer) :where(*) {\n  color: var(--wbts-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .conversation-list .conversation-agent-card span {\n  color: var(--wbts-text) !important;\n  -webkit-text-fill-color: var(--wbts-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .conversation-section-label :where(*) {\n  color: var(--wbts-m